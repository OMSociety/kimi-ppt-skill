{
  "name": "dsh-kimi-ppt-skill",
  "version": "1.0.1",
  "type": "module",
  "description": "DeepSeek Harness plugin that bundles the kimi-ppt skill: create/edit/export PPT with a locally generated .pptx and Pillow preview, no browser needed. Derived from the MIT open-kimi-ppt-skill (reverse-engineered Kimi Slides).",
  "author": "OMSociety (https://github.com/OMSociety)",
  "homepage": "https://github.com/OMSociety/kimi-ppt-skill#readme",
  "bugs": "https://github.com/OMSociety/kimi-ppt-skill/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OMSociety/kimi-ppt-skill.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "kimi",
    "ppt",
    "pptx",
    "slides",
    "skill"
  ],
  "main": "./plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
